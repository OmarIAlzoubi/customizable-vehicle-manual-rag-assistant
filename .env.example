# Get an API key from https://console.x.ai/
XAI_API_KEY=replace_with_your_key
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4.7
XAI_TIMEOUT_SECONDS=120

# Vehicle profile shown in the UI and used to scope Grok's answers.
# Add documents for this same vehicle before building the knowledge base.
VEHICLE_NAME=2023 Hyundai Elantra N

# Retrieval / local embedding settings
EMBEDDING_MODEL=intfloat/multilingual-e5-base
PDF_DIR=data/pdfs
KB_DB_PATH=data/generated/kb.db
KB_FAISS_PATH=data/generated/faiss.index
CHUNK_WORDS=380
CHUNK_OVERLAP_WORDS=60
TOP_K_SEMANTIC=6
TOP_K_KEYWORD=6
FINAL_K=6
MAX_CONTEXT_CHARS=16000
MAX_QUESTION_CHARS=2000
